{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/maxulysse/certificate/master/assets/schema_input.json",
    "title": "maxulysse/certificate pipeline - params.input schema",
    "description": "Schema for the file provided with params.input",
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
            "name": {
                "type": "string",
                "errorMessage": "Participant name must be provided",
                "meta": ["id"]
            },
            "certificate": {
                "type": "string",
                "format": "file-path",
                "exists": true,
                "pattern": "^\\S+\\.svg$",
                "errorMessage": "SVG source file, cannot contain spaces and must have extension '.svg'"
            },
            "place_date": {
                "type": "string",
                "meta": ["place_date"],
                "errorMessage": "Place_date/Date must be provided"
            },
            "signature": {
                "type": "string",
                "meta": ["signature"],
                "errorMessage": "Signature must be provided"
            },
            "text_line1": {
                "type": "string",
                "meta": ["text_line1"],
                "default": "",
                "errorMessage": "Text line 1 should be provided"
            },
            "text_line2": {
                "type": "string",
                "default": "",
                "meta": ["text_line2"],
                "errorMessage": "Text line 2 should be provided"
            },
            "text_line3": {
                "type": "string",
                "meta": ["text_line3"],
                "default": "",
                "errorMessage": "Text line 3 should be provided"
            }
        },
        "required": ["name", "certificate", "place_date", "signature"]
    }
}
